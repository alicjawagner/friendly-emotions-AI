<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".FriendlyEmotionsApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/friendly_emotions"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/friendly_emotions_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FriendlyEmotions">
        <activity
            android:name=".ChildActivity"
            android:exported="true"
            android:icon="@mipmap/friendly_emotions"
            android:label="@string/app_name_child"
            android:launchMode="singleTask"
            android:roundIcon="@mipmap/friendly_emotions_round"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.FriendlyEmotions">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".TherapistActivity"
            android:exported="true"
            android:icon="@mipmap/friendly_emotions_settings"
            android:label="@string/app_name_therapist"
            android:launchMode="singleTask"
            android:roundIcon="@mipmap/friendly_emotions_settings_round"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.FriendlyEmotions">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>