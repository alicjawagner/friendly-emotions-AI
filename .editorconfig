root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
max_line_length = 120
ij_kotlin_code_style_defaults = KOTLIN_OFFICIAL
# PascalCase is the standard naming convention for @Composable functions (they behave like
# factory functions returning UI), so ktlint's function-naming rule should not flag them.
ktlint_function_naming_ignore_when_annotated_with = Composable
